NEXT_PUBLIC_SITE_URL=
# Existing optional general-contact configuration (separate from CV requests)
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Secure CV portal — use an existing verified Resend sending domain.
CV_FROM_EMAIL=verification@shaunmathiasz.com
CV_OWNER_EMAIL=shaun.emirates@gmail.com
CV_APP_ORIGIN=
# Managed PostgreSQL; runtime role should not have schema/role administration.
DATABASE_URL=
# Required locally; trusted VERCEL_ENV controls deployed isolation.
CV_DATA_ENVIRONMENT=preview
# Optional separate privileged credential, used only by cv:migrate locally/CI.
CV_MIGRATION_DATABASE_URL=
# Random >=32-character HMAC key; never reuse the encryption key.
CV_OTP_HMAC_SECRET=
# 32 cryptographically random bytes encoded as base64.
CV_DATA_ENCRYPTION_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Private Vercel Blob connection. Prefer connected-store OIDC in deployments.
BLOB_STORE_ID=
# Only if using a token-based Blob connection; server-side only.
BLOB_READ_WRITE_TOKEN=
CV_BLOB_PATHNAME=
# >=32-character scheduled-worker secret; Vercel supplies Authorization automatically.
CRON_SECRET=
# Optional signed Resend delivery webhook, whsec_...; no delivery claims without it.
RESEND_WEBHOOK_SECRET=
# Defaults; deletion occurs on the next scheduled cleanup run.
CV_PENDING_RETENTION_HOURS=24
CV_IP_RETENTION_DAYS=30
CV_GPS_RETENTION_DAYS=7
CV_VERIFIED_RETENTION_DAYS=90
